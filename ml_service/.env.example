# ── AI Provider Configuration ────────────────────────────────────────────────
DEMO_MODE=true

# Skill extraction: "demo" or "llm"
SKILL_EXTRACTION_PROVIDER=demo

# Embedding model: "demo" or "sentence_transformer"
EMBEDDING_PROVIDER=demo

# Sentence Transformers model name (used when EMBEDDING_PROVIDER=sentence_transformer)
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# LLM configuration (only needed if SKILL_EXTRACTION_PROVIDER=llm)
# LLM_PROVIDER=none
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ── Service ───────────────────────────────────────────────────────────────────
PORT=8000
LOG_LEVEL=INFO

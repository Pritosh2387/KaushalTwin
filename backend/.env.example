# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=KaushalTwin Backend
API_PREFIX=/api/v1

# ── Database — MongoDB ─────────────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=kaushaltwin

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_generate_a_real_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── ML Providers Configuration ───────────────────────────────────────────────
# Skill Extraction Provider: demo or llm
SKILL_EXTRACTION_PROVIDER=demo
# LLM Skill Provider (when SKILL_EXTRACTION_PROVIDER=llm)
LLM_SKILL_API_KEY=your_llm_api_key_here
LLM_SKILL_MODEL=gpt-4o-mini

# Embedding Provider: demo or sentence_transformer
EMBEDDING_PROVIDER=demo
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=64

# Speech-to-Text Provider: mock or whisper
STT_PROVIDER=mock
WHISPER_MODEL_SIZE=base

# ML Service (for external ML service calls)
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT=30

# Demo Mode Configuration
# Set to true for demonstrations and development
DEMO_MODE=false
# Enable demo data seeding
DEMO_DATA_ENABLED=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# In production, specify actual domains (no localhost)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIRECTORY=./uploads
# Max upload size in bytes (10 MB default)
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,mp4,mov,docx,txt

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s | %(levelname)s | %(name)s | %(message)s

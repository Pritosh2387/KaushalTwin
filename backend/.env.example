# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=KaushalTwin Backend
API_PREFIX=/api/v1

# ── Database — MongoDB ─────────────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=kaushaltwin

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_generate_a_real_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── ML Intelligence Layer ─────────────────────────────────────────────────────
# Embedded by default inside backend; external URL fallback supported
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT=30

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIRECTORY=./uploads
# Max upload size in bytes (10 MB default)
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,mp4,mov,docx,txt
